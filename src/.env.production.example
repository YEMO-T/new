# 前端生产环境配置示例
# 复制此文件为 .env.production，然后填充实际值

# ===== API 配置 =====
REACT_APP_API_BASE_URL=https://api.dousha.com/api
REACT_APP_TIMEOUT=330000
REACT_APP_API_VERSION=v1

# ===== 应用信息 =====
REACT_APP_NAME=豆沙包教师助手
REACT_APP_VERSION=1.0.0
REACT_APP_ENVIRONMENT=production

# ===== 分析和监控 =====
# Sentry: https://sentry.io
REACT_APP_SENTRY_DSN=https://key@domain.ingest.sentry.io/project-id

# Google Analytics
REACT_APP_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Hotjar (用户行为分析)
REACT_APP_HOTJAR_ID=123456

# ===== 功能开关 =====
REACT_APP_ENABLE_TEMPLATES=true
REACT_APP_ENABLE_KNOWLEDGE_BASE=true
REACT_APP_ENABLE_EXPORTS=true
REACT_APP_ENABLE_ANALYTICS=true

# ===== 第三方服务 =====
REACT_APP_CDN_URL=https://d123abc456.cloudfront.net
REACT_APP_STORAGE_URL=https://dousha-uploads.s3.amazonaws.com

# ===== 功能配置 =====
REACT_APP_MAX_FILE_SIZE=52428800
REACT_APP_SESSION_TIMEOUT=3600000
REACT_APP_AUTO_SAVE_INTERVAL=30000
